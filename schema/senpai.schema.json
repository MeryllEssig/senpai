{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MeryllEssig/senpai/main/schema/senpai.schema.json",
  "title": "SenpAI manifest v2",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "environmentVariable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "relativePath": { "anyOf": [{ "const": "." }, { "type": "string", "pattern": "^[^/\\\\]+(/[^/\\\\]+)*$", "not": { "pattern": "(^|/)\\.\\.?(/|$)" } }] },
    "permission": { "type": "string", "enum": ["allow", "confirm", "deny"] },
    "ticketOperation": { "enum": ["ticket.read", "ticket.create", "ticket.update", "ticket.comment", "ticket.transition", "ticket.link", "ticket.log_time"] },
    "codeOperation": { "enum": ["code.read", "code.create", "code.update", "code.comment", "code.request_review", "code.merge", "code.pipeline_read", "code.pipeline_trigger"] },
    "auth": { "type": "object", "properties": { "mode": { "type": "string", "enum": ["preconfigured", "env", "interactive"] }, "token_env": { "$ref": "#/$defs/environmentVariable" }, "api_key_env": { "$ref": "#/$defs/environmentVariable" }, "password_env": { "$ref": "#/$defs/environmentVariable" } }, "required": ["mode"], "patternProperties": { "^[A-Za-z][A-Za-z0-9_]*_env$": { "$ref": "#/$defs/environmentVariable" } }, "additionalProperties": false },
    "workflow": { "type": "object", "properties": { "skill": { "type": "string", "minLength": 1 }, "policy": { "type": "object", "additionalProperties": { "$ref": "#/$defs/permission" } } }, "additionalProperties": false },
    "adapter": { "type": "object", "properties": { "skill": { "type": "string", "minLength": 1 } }, "required": ["skill"], "additionalProperties": false },
    "routing": { "type": "object", "properties": { "ticket_id_patterns": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "regex" } }, "priority": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "integration": {
      "type": "object",
      "properties": { "kind": { "enum": ["ticketing", "forge"] }, "platform": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri" }, "scope": { "type": "object" }, "auth": { "$ref": "#/$defs/auth" }, "provides": { "type": "array", "minItems": 1, "uniqueItems": true }, "handles": { "type": "array", "minItems": 1, "uniqueItems": true }, "workflow": { "$ref": "#/$defs/workflow" }, "adapter": { "$ref": "#/$defs/adapter" }, "routing": { "$ref": "#/$defs/routing" }, "note": { "type": "string" } },
      "required": ["kind", "platform", "url", "provides", "handles"], "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "kind": { "const": "ticketing" } } }, "then": { "properties": { "provides": { "type": "array", "items": { "$ref": "#/$defs/ticketOperation" } }, "handles": { "type": "array", "items": { "$ref": "#/$defs/ticketOperation" } }, "workflow": { "type": "object", "properties": { "policy": { "type": "object", "properties": { "read": { "$ref": "#/$defs/permission" }, "create": { "$ref": "#/$defs/permission" }, "update": { "$ref": "#/$defs/permission" }, "comment": { "$ref": "#/$defs/permission" }, "transition": { "$ref": "#/$defs/permission" }, "link": { "$ref": "#/$defs/permission" }, "log_time": { "$ref": "#/$defs/permission" } }, "additionalProperties": false } } } } } },
        { "if": { "properties": { "kind": { "const": "forge" } } }, "then": { "properties": { "provides": { "type": "array", "items": { "$ref": "#/$defs/codeOperation" } }, "handles": { "type": "array", "items": { "$ref": "#/$defs/codeOperation" } }, "workflow": { "type": "object", "properties": { "policy": { "type": "object", "properties": { "read": { "$ref": "#/$defs/permission" }, "create": { "$ref": "#/$defs/permission" }, "update": { "$ref": "#/$defs/permission" }, "comment": { "$ref": "#/$defs/permission" }, "request_review": { "$ref": "#/$defs/permission" }, "merge": { "$ref": "#/$defs/permission" }, "pipeline_read": { "$ref": "#/$defs/permission" }, "pipeline_trigger": { "$ref": "#/$defs/permission" } }, "additionalProperties": false } } } } } }
      ]
    },
    "repo": { "type": "object", "properties": { "path": { "$ref": "#/$defs/relativePath" }, "role": { "type": "string", "minLength": 1 }, "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }, "integrations": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "type": "string", "minLength": 1 } }, "additionalProperties": false } }, "required": ["path"], "additionalProperties": false },
    "project": { "type": "object", "properties": { "name": { "$ref": "#/$defs/identifier" }, "label": { "type": "string", "minLength": 1 }, "context": { "type": "string" }, "stack": { "type": "array", "items": { "type": "string", "minLength": 1 } } }, "required": ["name", "label", "context", "stack"], "additionalProperties": false },
    "environment": { "type": "object", "properties": { "label": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri" }, "repo": { "$ref": "#/$defs/identifier" }, "note": { "type": "string" } }, "required": ["label"], "additionalProperties": false },
    "capsule": { "type": "object", "properties": { "label": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "program": { "type": "string", "minLength": 1 }, "args": { "type": "array", "items": { "type": "string" } }, "supplied": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }, "cwd": { "$ref": "#/$defs/relativePath" }, "environment": { "$ref": "#/$defs/identifier" }, "repo": { "$ref": "#/$defs/identifier" }, "note": { "type": "string" }, "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }, "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 } }, "required": ["label", "program", "args"], "additionalProperties": false },
    "documentation": { "type": "object", "properties": { "path": { "$ref": "#/$defs/relativePath" }, "url": { "type": "string", "format": "uri" }, "repository_url": { "type": "string", "format": "uri" }, "repo": { "$ref": "#/$defs/identifier" }, "label": { "type": "string", "minLength": 1 }, "note": { "type": "string" } }, "oneOf": [{ "required": ["path"] }, { "required": ["url"] }, { "required": ["repository_url"] }], "additionalProperties": false },
    "manifest": { "type": "object", "properties": { "$schema": { "const": "https://raw.githubusercontent.com/MeryllEssig/senpai/main/schema/senpai.schema.json" }, "version": { "const": 2 }, "project": { "$ref": "#/$defs/project" }, "integrations": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/integration" } }, "additionalProperties": false }, "adapter_overrides": { "type": "object", "properties": { "ticketing": { "type": "object", "additionalProperties": { "$ref": "#/$defs/adapter" } }, "forge": { "type": "object", "additionalProperties": { "$ref": "#/$defs/adapter" } } }, "additionalProperties": false }, "repos": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/repo" } }, "additionalProperties": false }, "environments": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/environment" } }, "additionalProperties": false }, "capsules": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/capsule" } }, "additionalProperties": false }, "docs": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/documentation" } }, "additionalProperties": false } }, "required": ["version", "project", "integrations"], "additionalProperties": false }
  }
}
