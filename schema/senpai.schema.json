{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senpai.dev/schema/v1/senpai.schema.json",
  "title": "Senpai manifest v1",
  "description": "The committed .senpai.jsonc manifest. JSONC comments must be removed by a JSONC parser before schema validation.",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "environmentVariable": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "relativePath": {
      "description": "A normalized POSIX path relative to the manifest directory, using forward slashes only. A single dot names the manifest directory itself.",
      "anyOf": [
        { "const": "." },
        {
          "type": "string",
          "pattern": "^[^/\\\\]+(/[^/\\\\]+)*$",
          "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
        }
      ]
    },
    "capsuleParameter": {
      "allOf": [
        { "$ref": "#/$defs/identifier" },
        { "not": { "enum": ["help", "json", "manifest", "version"] } }
      ]
    },
    "access": {
      "type": "string",
      "enum": ["read-only"],
      "description": "Optional advisory hint for the LLM. Senpai does not enforce it."
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["preconfigured", "env", "interactive"] },
        "token_env": { "$ref": "#/$defs/environmentVariable" },
        "api_key_env": { "$ref": "#/$defs/environmentVariable" },
        "password_env": { "$ref": "#/$defs/environmentVariable" }
      },
      "required": ["mode"],
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_]*_env$": { "$ref": "#/$defs/environmentVariable" }
      },
      "additionalProperties": false
    },
    "workflowPermission": {
      "type": "string",
      "enum": ["allow", "confirm", "deny"]
    },
    "ticketPolicy": {
      "type": "object",
      "description": "Project-wide authorization policy for the common ticket interface. Omitted read defaults to allow; every other omitted capability defaults to deny.",
      "properties": {
        "read": { "$ref": "#/$defs/workflowPermission" },
        "create": { "$ref": "#/$defs/workflowPermission" },
        "update": { "$ref": "#/$defs/workflowPermission" },
        "comment": { "$ref": "#/$defs/workflowPermission" },
        "transition": { "$ref": "#/$defs/workflowPermission" },
        "link": { "$ref": "#/$defs/workflowPermission" },
        "log_time": { "$ref": "#/$defs/workflowPermission" }
      },
      "additionalProperties": false
    },
    "codeChangePolicy": {
      "type": "object",
      "description": "Project-wide authorization policy for the common code-change interface. Omitted read defaults to allow; every other omitted capability defaults to deny.",
      "properties": {
        "read": { "$ref": "#/$defs/workflowPermission" },
        "create": { "$ref": "#/$defs/workflowPermission" },
        "update": { "$ref": "#/$defs/workflowPermission" },
        "comment": { "$ref": "#/$defs/workflowPermission" },
        "request_review": { "$ref": "#/$defs/workflowPermission" },
        "merge": { "$ref": "#/$defs/workflowPermission" },
        "pipeline_read": { "$ref": "#/$defs/workflowPermission" },
        "pipeline_trigger": { "$ref": "#/$defs/workflowPermission" }
      },
      "additionalProperties": false
    },
    "workflows": {
      "type": "object",
      "properties": {
        "tickets": {
          "type": "object",
          "properties": {
            "skill": { "type": "string", "minLength": 1 },
            "policy": { "$ref": "#/$defs/ticketPolicy" }
          },
          "required": ["skill", "policy"],
          "additionalProperties": false
        },
        "code_changes": {
          "type": "object",
          "properties": {
            "skill": { "type": "string", "minLength": 1 },
            "policy": { "$ref": "#/$defs/codeChangePolicy" }
          },
          "required": ["skill", "policy"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "stack": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["name", "label", "context", "stack"],
      "additionalProperties": false
    },
    "trackerSource": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "project": { "type": "string", "minLength": 1 },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "priority": { "type": "integer", "minimum": 0 },
        "ticket_id_patterns": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "regex" } },
        "time_logging": {
          "type": "object",
          "properties": { "catch_all_ticket": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        "auth": { "$ref": "#/$defs/auth" },
        "skill": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "required": ["type", "url", "project", "roles"],
      "additionalProperties": false
    },
    "hostingInstance": {
      "type": "object",
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "auth": { "$ref": "#/$defs/auth" },
        "skill": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "required": ["platform", "url", "roles"],
      "additionalProperties": false
    },
    "repo": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "role": { "type": "string", "minLength": 1 },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "hosting": {
          "type": "object",
          "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "repo": { "$ref": "#/$defs/identifier" },
        "note": { "type": "string" }
      },
      "required": ["label"],
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "properties": {
        "server": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 }
      },
      "required": ["server"],
      "additionalProperties": false
    },
    "capsule": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "supplied": { "type": "array", "uniqueItems": true, "default": [], "items": { "$ref": "#/$defs/capsuleParameter" } },
        "cwd": { "$ref": "#/$defs/relativePath" },
        "environment": { "$ref": "#/$defs/identifier" },
        "repo": { "$ref": "#/$defs/identifier" },
        "mcp": { "$ref": "#/$defs/mcp" },
        "access": { "$ref": "#/$defs/access" },
        "note": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 30 },
        "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600, "default": 1048576 }
      },
      "required": ["label", "command"],
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "url": { "type": "string", "format": "uri" },
        "repository_url": { "type": "string", "format": "uri" },
        "repo": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "oneOf": [
        { "required": ["path"], "not": { "anyOf": [{ "required": ["url"] }, { "required": ["repository_url"] }] } },
        { "required": ["url"], "not": { "anyOf": [{ "required": ["path"] }, { "required": ["repository_url"] }] } },
        { "required": ["repository_url"], "not": { "anyOf": [{ "required": ["path"] }, { "required": ["url"] }] } }
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "if": { "type": "string", "minLength": 1 },
        "then": { "type": "string", "minLength": 1 }
      },
      "required": ["if", "then"],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "$schema": { "const": "https://senpai.dev/schema/v1/senpai.schema.json" },
        "version": { "const": 1 },
        "project": { "$ref": "#/$defs/project" },
        "trackers": {
          "type": "object",
          "properties": { "sources": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/trackerSource" } }, "additionalProperties": false } },
          "required": ["sources"],
          "additionalProperties": false
        },
        "code_hosting": {
          "type": "object",
          "properties": { "instances": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/hostingInstance" } }, "additionalProperties": false } },
          "required": ["instances"],
          "additionalProperties": false
        },
        "workflows": { "$ref": "#/$defs/workflows" },
        "repos": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/repo" } }, "additionalProperties": false },
        "environments": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/environment" } }, "additionalProperties": false },
        "capsules": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/capsule" } }, "additionalProperties": false },
        "docs": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/documentation" } }, "additionalProperties": false },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
      },
      "required": ["version", "project"],
      "additionalProperties": false
    }
  }
}
