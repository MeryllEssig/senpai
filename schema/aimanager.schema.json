{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimanager.dev/schema/v1/aimanager.schema.json",
  "title": "AI Manager manifest v1",
  "description": "The committed .aimanager.jsonc manifest. JSONC comments must be removed by a JSONC parser before schema validation.",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "environmentVariable": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "access": {
      "type": "string",
      "enum": ["read-only"],
      "description": "Optional advisory hint for the LLM. AI Manager does not enforce it."
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["preconfigured", "env", "interactive"] },
        "token_env": { "$ref": "#/$defs/environmentVariable" },
        "api_key_env": { "$ref": "#/$defs/environmentVariable" },
        "password_env": { "$ref": "#/$defs/environmentVariable" }
      },
      "required": ["mode"],
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_]*_env$": { "$ref": "#/$defs/environmentVariable" }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "stack": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["name", "label", "context", "stack"],
      "additionalProperties": false
    },
    "trackerSource": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "project": { "type": "string", "minLength": 1 },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "priority": { "type": "integer", "minimum": 0 },
        "ticket_id_patterns": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "regex" } },
        "time_logging": {
          "type": "object",
          "properties": { "catch_all_ticket": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        "auth": { "$ref": "#/$defs/auth" },
        "skill": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "required": ["type", "url", "project", "roles"],
      "additionalProperties": false
    },
    "hostingInstance": {
      "type": "object",
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "auth": { "$ref": "#/$defs/auth" },
        "skill": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "required": ["platform", "url", "roles"],
      "additionalProperties": false
    },
    "repo": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" } },
        "role": { "type": "string", "minLength": 1 },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "hosting": {
          "type": "object",
          "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "ssh": {
      "type": "object",
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 },
        "jump_host": { "type": "string", "minLength": 1 },
        "access": { "$ref": "#/$defs/access" },
        "repo": { "$ref": "#/$defs/identifier" },
        "note": { "type": "string" }
      },
      "required": ["host"],
      "additionalProperties": false
    },
    "logs": {
      "type": "object",
      "properties": {
        "transport": { "type": "string", "enum": ["ssh", "file"] },
        "journal_unit": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "access": { "$ref": "#/$defs/access" },
        "repo": { "$ref": "#/$defs/identifier" },
        "note": { "type": "string" }
      },
      "required": ["transport"],
      "allOf": [
        { "if": { "properties": { "transport": { "const": "ssh" } } }, "then": { "required": ["journal_unit"] } },
        { "if": { "properties": { "transport": { "const": "file" } } }, "then": { "required": ["path"] } }
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "repo": { "$ref": "#/$defs/identifier" },
        "ssh": { "$ref": "#/$defs/ssh" },
        "logs": { "$ref": "#/$defs/logs" },
        "note": { "type": "string" }
      },
      "required": ["label"],
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "properties": { "server": { "type": "string", "minLength": 1 } },
      "required": ["server"],
      "additionalProperties": false
    },
    "dataStore": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "environment": { "$ref": "#/$defs/identifier" },
        "connector": { "$ref": "#/$defs/identifier" },
        "repo": { "$ref": "#/$defs/identifier" },
        "access": { "$ref": "#/$defs/access" },
        "note": { "type": "string" },
        "mcp": { "$ref": "#/$defs/mcp" },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "endpoint": { "type": "string", "format": "uri" },
        "engine": { "type": "string", "minLength": 1 },
        "database": { "type": ["string", "integer"], "minLength": 1 },
        "db": { "type": "integer", "minimum": 0 },
        "index": { "type": "string", "minLength": 1 },
        "core": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 }
      },
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_]*_env$": { "$ref": "#/$defs/environmentVariable" }
      },
      "required": ["type", "environment"],
      "allOf": [
        { "if": { "properties": { "type": { "const": "database" } } }, "then": { "required": ["engine", "host", "port", "database"] } },
        { "if": { "properties": { "type": { "const": "elasticsearch" } } }, "then": { "required": ["endpoint", "index"] } },
        { "if": { "properties": { "type": { "const": "solr" } } }, "then": { "required": ["endpoint", "core"] } },
        { "if": { "properties": { "type": { "const": "redis" } } }, "then": { "required": ["endpoint", "db"] } },
        {
          "if": { "properties": { "type": { "not": { "enum": ["database", "elasticsearch", "solr", "redis"] } } } },
          "then": { "anyOf": [{ "required": ["endpoint"] }, { "required": ["host"] }] }
        }
      ],
      "additionalProperties": true
    },
    "capsule": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "supplied": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "environment": { "$ref": "#/$defs/identifier" },
        "repo": { "$ref": "#/$defs/identifier" },
        "access": { "$ref": "#/$defs/access" },
        "engine": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 30 },
        "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600, "default": 1048576 }
      },
      "required": ["command", "supplied"],
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" } },
        "url": { "type": "string", "format": "uri" },
        "repository_url": { "type": "string", "format": "uri" },
        "repo": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "oneOf": [
        { "required": ["path"], "not": { "anyOf": [{ "required": ["url"] }, { "required": ["repository_url"] }] } },
        { "required": ["url"], "not": { "anyOf": [{ "required": ["path"] }, { "required": ["repository_url"] }] } },
        { "required": ["repository_url"], "not": { "anyOf": [{ "required": ["path"] }, { "required": ["url"] }] } }
      ],
      "additionalProperties": false
    },
    "localCommand": {
      "type": "object",
      "properties": {
        "run": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      },
      "required": ["run", "label"],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "if": { "type": "string", "minLength": 1 },
        "then": { "type": "string", "minLength": 1 }
      },
      "required": ["if", "then"],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "$schema": { "const": "https://aimanager.dev/schema/v1/aimanager.schema.json" },
        "version": { "const": 1 },
        "project": { "$ref": "#/$defs/project" },
        "trackers": {
          "type": "object",
          "properties": { "sources": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/trackerSource" } }, "additionalProperties": false } },
          "required": ["sources"],
          "additionalProperties": false
        },
        "code_hosting": {
          "type": "object",
          "properties": { "instances": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/hostingInstance" } }, "additionalProperties": false } },
          "required": ["instances"],
          "additionalProperties": false
        },
        "repos": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/repo" } }, "additionalProperties": false },
        "environments": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/environment" } }, "additionalProperties": false },
        "data_stores": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/dataStore" } }, "additionalProperties": false },
        "capsules": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/capsule" } }, "additionalProperties": false },
        "docs": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/documentation" } }, "additionalProperties": false },
        "local_commands": { "type": "object", "patternProperties": { "^[A-Za-z][A-Za-z0-9_-]*$": { "$ref": "#/$defs/localCommand" } }, "additionalProperties": false },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
      },
      "required": ["version", "project"],
      "additionalProperties": false
    }
  }
}
