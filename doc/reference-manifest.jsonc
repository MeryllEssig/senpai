// =============================================================================
// .aimanager.jsonc - REFERENCE EXAMPLE ("golden" manifest)
// =============================================================================
// This file is the reference example for the AI Manager manifest format. It
// freezes the schema: every feature described in the spec documents appears
// here at least once, with the exact field shapes the docs define.
//
//   - doc/goal.md                     what AI Manager is and is not
//   - doc/user-stories.md             who needs what and why
//   - doc/technical-considerations.md field shapes (sections 1.1 to 1.10)
//   - doc/notes.md                    cross-cutting process notes
//
// The project below is entirely fictional: an "acme" client, example hosts,
// billing/catalog repos. No real client, company, URL, or credential appears.
//
// Ground rules the format guarantees:
//   - Declarative, with one guarded exception. The manifest states what
//     exists and how to reach it; the only executable surface is the typed
//     "local_commands" category (guarded by the trust model, preferably kept
//     in the personal overlay). No shell strings appear anywhere else,
//     notably never in connector fields.
//   - No secret values. Credentials are referenced by environment variable
//     NAME only (for example "password_env"), never by value.
//   - JSONC. Comments are encouraged: the file should explain itself to
//     teammates and to AI agents alike.
//
// Resolution: the CLI finds this file by walking up the directory tree from
// the current working directory, exactly like .git discovery. It can sit at
// the repo root, in a parent directory of a client repo that must not carry
// tooling files, or in any plain folder (git is not required). The nearest
// manifest wins in full; manifests never merge or inherit from one another.
//
// Personal overlay: a gitignored .aimanager.local.jsonc placed beside this
// file is deep-merged over it for private paths, preferences, and personal
// auth or local_commands overrides (technical-considerations 1.9).
// =============================================================================
{
  // Manifest schema version, present from day one so the schema can evolve
  // without breaking existing manifests. Integer, starts at 1.
  "version": 1,

  // ---------------------------------------------------------------------------
  // Project identity
  // ---------------------------------------------------------------------------
  // Who this project is. "context" is free text addressed to the AI agent:
  // anything a new teammate would need on day one belongs there.
  "project": {
    // Machine-friendly identifier (slug).
    "name": "acme-shop",
    // Human-friendly display name.
    "label": "ACME Online Shop",
    // Free-text context for the AI. Keep it short and factual.
    "context": "E-commerce platform built by the agency for the ACME client. Multi-repo galaxy: a root orchestrator repo plus interdependent sub-repos under www/. Two synchronized GitLab instances: merge requests and test pipelines on the agency instance, deployment pipelines on the client instance. Ticket details are authoritative on the client Jira; time is booked on the agency Redmine, currently on the dedicated build-phase project space (see trackers).",
    // Free-form technology hints for the agent, not an enum.
    "stack": ["php 8.3 / symfony 7", "vue 3", "mysql 8", "elasticsearch 8", "solr 9", "redis 7"]
  },

  // ---------------------------------------------------------------------------
  // Trackers: several sources, routed by function (technical-considerations 1.3)
  // ---------------------------------------------------------------------------
  // Routing is by FUNCTION, never by theme (no bug/chore split). Each source
  // declares the "roles" it plays; the agent routes actions accordingly:
  //   - "ticket_details": the authoritative source ("makes foi") for reading a
  //     ticket's content. Usually the client's tracker.
  //   - "time_logging": where time spent is booked. Usually our internal
  //     tracker; may name a catch-all ticket for time with no dedicated ticket.
  //   - "external_refs": a source that cross-links references to/from another.
  //   - "hosting_requests": a tracker used to open/read hosting-provider
  //     requests; does NOT make foi. (When the hosting team is in the same
  //     company, this can be a separate project space on "internal" instead.)
  // The role set is open (LLM-readable strings), not a closed enum.
  //
  // Optional "auth" on a source (same on code_hosting instances) declares how
  // the matching external command authenticates; commands differ, so the mode
  // does too:
  //   - "preconfigured" (default when "auth" is absent): the CLI is already
  //     set up on the machine, authentication stays in the user's hands.
  //   - "env": credentials live in environment variables referenced by NAME
  //     ("api_key_env", "token_env", "password_env"...); the agent may drive
  //     the login or re-login process itself, never reading the values.
  //   - "interactive": the agent starts the CLI's login flow and hands over
  //     to the user to complete it.
  // Secret VALUES are forbidden in this file in every mode. If the agent has
  // no way to authenticate without reading a secret value itself, it must
  // stop entirely and ask the user how to proceed (core behavior).
  "trackers": {
    // Source types shown in the docs: "redmine", "jira", "linear". The set
    // is not closed yet (no JSON Schema published).
    "sources": {
      // The client's tracker: authoritative for ticket content, read ticket
      // details here. No "auth": the Jira CLI is assumed pre-configured, the
      // user keeps full control of authentication.
      "client": {
        "type": "jira",
        "url": "https://acme.atlassian.net",
        "project": "ACME",
        "roles": ["ticket_details"]
      },
      // The agency tracker: where time is booked during the build phase, and
      // where the client reference is carried back. Auth mode "env": the agent
      // may log the Redmine CLI in by itself, passing the variable by name only.
      "internal": {
        "type": "redmine",
        "url": "https://redmine.agency.example",
        "project": "acme-build",
        "auth": { "mode": "env", "api_key_env": "REDMINE_AGENCY_API_KEY" },
        "roles": ["time_logging", "external_refs"],
        // Optional catch-all ticket to book time with no dedicated ticket.
        "time_logging": { "catch_all_ticket": "SUPPORT-0" }
      },
      // A hosting provider's tracker: NOT authoritative ("does not make foi"),
      // used only to open and read hosting requests. When the hosting team is
      // inside the same company, this can instead be a separate project space
      // on the "internal" source rather than a distinct source.
      "hosting": {
        "type": "redmine",
        "url": "https://redmine.hosting-provider.example",
        "project": "hosting-acme",
        "roles": ["hosting_requests"]
      }
    }
    // No single "write_target": actions route by role. Reading details -> the
    // "ticket_details" source; booking time -> the "time_logging" source. The
    // build -> maintenance lifecycle move is a one-line change to the "project"
    // of the "internal" source (from "acme-build" to "maintenance-general").
  },

  // ---------------------------------------------------------------------------
  // Code hosting: synchronized instances with roles (technical-considerations 1.5)
  // ---------------------------------------------------------------------------
  // Each hosting endpoint is declared once, with "roles" stating which
  // operations belong to it. With roles declared, "create the MR" routes to
  // "dev" and "trigger the deployment" routes to "ops" without any
  // per-request instruction. A single-instance project declares one instance
  // holding every role.
  "code_hosting": {
    "instances": {
      "dev": {
        "platform": "gitlab",
        "url": "https://gitlab.agency.example",
        // The agent picks the instance by role.
        "roles": ["merge_requests", "test_pipelines"],
        // Auth mode "env": if glab is not yet configured for this instance,
        // the agent may run the login itself with the variable by name.
        "auth": { "mode": "env", "token_env": "GITLAB_AGENCY_TOKEN" }
      },
      "ops": {
        "platform": "gitlab",
        "url": "https://gitlab.client.example",
        "roles": ["deployment_pipelines"],
        // Auth mode "interactive": the agent may start "glab auth login" for
        // this instance but the user completes the flow.
        "auth": { "mode": "interactive" }
      }
    }
  },

  // ---------------------------------------------------------------------------
  // Repos: the multi-repo galaxy (technical-considerations 1.4 and 1.5)
  // ---------------------------------------------------------------------------
  // One manifest at the galaxy root describes the members and their
  // "depends_on" edges. "role" is a free-form hint for the agent, not an enum
  // the CLI interprets. "path" is relative to the directory containing this
  // manifest. "hosting" maps instance ids (declared above) to the repo's path
  // on that instance; mirrors can differ in namespace, and a repo may exist
  // on only one instance.
  "repos": {
    // The galaxy root: orchestration scripts, CI, provisioning.
    "root": {
      "path": ".",
      "role": "orchestrator",
      "hosting": { "dev": "acme/shop-galaxy" }
    },
    // Shared code consumed by the other members.
    "bundle_core": {
      "path": "www/bundle_core",
      "role": "shared bundle (domain entities, helpers)",
      // Internal-only repo: present on the dev instance, not mirrored.
      "hosting": { "dev": "acme/bundle-core" }
    },
    "api_billing": {
      "path": "www/api_billing",
      "role": "api",
      "depends_on": ["bundle_core"],
      // Instance id -> repo path on that instance.
      "hosting": { "dev": "acme/api-billing", "ops": "client-mirror/api-billing" }
    },
    "front_billing": {
      "path": "www/front_billing",
      "role": "front",
      "depends_on": ["api_billing"],
      "hosting": { "dev": "acme/front-billing", "ops": "client-mirror/front-billing" }
    },
    "front_catalog": {
      "path": "www/front_catalog",
      "role": "front",
      "depends_on": ["bundle_core"],
      "hosting": { "dev": "acme/front-catalog", "ops": "client-mirror/front-catalog" }
    }
  },

  // ---------------------------------------------------------------------------
  // Environments and their typed connectors (technical-considerations 1.6)
  // ---------------------------------------------------------------------------
  // Environment ids are free-form map keys; the suggested (not enforced)
  // convention is dev / preprod (staging) / prod. This example uses preprod
  // and prod (technical-considerations 1.6).
  // Connectors nested under an environment belong to it, so they do not
  // repeat an "environment" field.
  "environments": {
    "preprod": {
      "label": "Preprod (staging)",
      "url": "https://preprod.shop.acme.example",
      // Typed ssh connector: host, optional user and jump host.
      "ssh": {
        "host": "preprod-web01.acme.example",
        "user": "deploy",
        "jump_host": "bastion.agency.example"
      },
      // Typed logs connector, transport "ssh": the agent reads the systemd
      // journal unit through this environment's ssh connector above.
      "logs": {
        "transport": "ssh",
        "journal_unit": "acme-shop.service"
      }
    },
    "prod": {
      "label": "Production",
      "url": "https://shop.acme.example",
      // No ssh connector on purpose: agents never ssh to prod (see rules).
      // Typed logs connector, transport "file": prod logs are shipped to a
      // share mounted on the workstation, readable without touching prod.
      "logs": {
        "transport": "file",
        "path": "/mnt/acme-logs/prod/app.log"
      }
    }
  },

  // ---------------------------------------------------------------------------
  // Data stores: typed, declarative connectors (technical-considerations 1.6)
  // ---------------------------------------------------------------------------
  // "type" selects the connector shape. "environment" points to a declared
  // environment above. Usernames are plain (not secrets); passwords, tokens
  // and API keys are referenced by environment variable NAME only
  // (technical-considerations 1.7). Never put a secret value here.
  "data_stores": {
    "db_preprod": {
      "type": "database",
      "environment": "preprod",
      "engine": "mysql",
      "host": "db.preprod.acme.example",
      "port": 3306,
      "database": "acme_shop",
      "user": "acme_ro",
      "password_env": "ACME_PREPROD_DB_PASSWORD"
    },
    "db_prod": {
      "type": "database",
      "environment": "prod",
      "engine": "mysql",
      "host": "db.prod.acme.example",
      "port": 3306,
      "database": "acme_shop",
      // Read-only account; the structured "access" marker lets tooling and the
      // agent check the guardrail without parsing prose (a rule below forbids
      // writes too). See technical-considerations 1.8.
      "user": "acme_ro",
      "access": "read-only",
      "password_env": "ACME_PROD_DB_PASSWORD"
    },
    // Search layer: Elasticsearch declares an index.
    "search_products": {
      "type": "elasticsearch",
      "environment": "preprod",
      "endpoint": "https://es.preprod.acme.example:9200",
      "index": "acme_products",
      "api_key_env": "ACME_PREPROD_ES_API_KEY"
    },
    // Legacy search layer: Solr declares a core.
    "search_legacy": {
      "type": "solr",
      "environment": "preprod",
      "endpoint": "https://solr.preprod.acme.example:8983",
      "core": "acme_catalog",
      "user": "solr_ro",
      "password_env": "ACME_PREPROD_SOLR_PASSWORD"
    },
    // Cache layer: Redis declares a numeric db.
    "cache": {
      "type": "redis",
      "environment": "preprod",
      "endpoint": "redis://redis.preprod.acme.example:6379",
      "db": 0,
      "password_env": "ACME_PREPROD_REDIS_PASSWORD"
    }
  },

  // ---------------------------------------------------------------------------
  // Documentation locations (technical-considerations 1.6, "docs" connector)
  // ---------------------------------------------------------------------------
  // Each entry declares exactly one location field: "path" (local, relative
  // to the directory containing this manifest), "url" (remote page or space),
  // or "repo" (remote repository holding documentation).
  "docs": {
    "functional": {
      "path": "doc/functional",
      "label": "Functional specifications (markdown, versioned with the galaxy)"
    },
    "wiki": {
      "url": "https://wiki.agency.example/acme-shop",
      "label": "Agency wiki space for the project"
    },
    "architecture": {
      "repo": "https://gitlab.agency.example/acme/architecture-docs.git",
      "label": "Architecture decision records"
    }
  },

  // ---------------------------------------------------------------------------
  // Local commands: acting on this project locally (technical-considerations 1.10)
  // ---------------------------------------------------------------------------
  // The manifest's one executable surface: typed and explicit, never smuggled
  // into a connector field. The CLI lists these; the agent decides whether to
  // run one. A "local_commands" block in a COMMITTED manifest is subject to
  // confirmation on first use (see technical-considerations 5); self-authored
  // commands belong in the gitignored .aimanager.local.jsonc overlay instead.
  "local_commands": {
    "logs_local": {
      "run": "docker compose logs -f app",
      "label": "Tail the local app container logs"
    },
    "db_shell": {
      "run": "docker compose exec db mysql -u acme_ro acme_shop",
      "label": "Open a read-only MySQL shell in the local db container"
    }
  },

  // ---------------------------------------------------------------------------
  // IF-THEN intent rules and guardrails (technical-considerations 1.8)
  // ---------------------------------------------------------------------------
  // A declarative routing table from intents to approaches. "if" is a
  // plain-language condition the agent recognizes in the user's request;
  // "then" is the instruction to follow. AI Manager does not install, verify,
  // or execute the referenced skills or commands; the agent resolves them
  // itself. This is also the place for project-specific guardrails.
  "rules": [
    // Skill routing.
    { "if": "database access is needed", "then": "use the 'db-inspect' skill with the matching data_stores connector" },
    { "if": "a ticket must be read", "then": "use the 'ticket-workflow' skill; read details from the source holding the 'ticket_details' role" },
    { "if": "time must be booked for work done", "then": "use the 'ticket-workflow' skill; book time on the source holding the 'time_logging' role" },

    // Connector routing.
    { "if": "prod logs are needed", "then": "use the logs connector of the prod environment; never ssh to prod directly" },
    { "if": "merge requests are needed after changes in several repos", "then": "create one merge request per modified repo, each on the instance holding the 'merge_requests' role" },

    // Guardrails.
    { "if": "an operation would write to the prod database", "then": "do not do it; the prod database is strictly read-only for agents, ask the user instead" },
    { "if": "a ticket would be created in the client Jira", "then": "ask the user for explicit confirmation first" }
  ]
}
