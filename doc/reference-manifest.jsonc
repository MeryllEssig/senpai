// SenpAI manifest v2 reference. It contains no secret values: auth names are
// read by the selected adapter itself.
{
  "$schema": "https://raw.githubusercontent.com/MeryllEssig/senpai/main/schema/senpai.schema.json",
  "version": 2,
  "project": {
    "name": "acme-shop",
    "label": "ACME Online Shop",
    "context": "Multi-repository ACME e-commerce project.",
    "stack": ["php 8.3 / symfony 7", "vue 3"]
  },
  "adapter_overrides": {
    "ticketing": { "redmine": { "skill": "acme-redmine-adapter" } }
  },
  "integrations": {
    "client_jira": {
      "kind": "ticketing",
      "platform": "jira",
      "url": "https://acme.atlassian.net",
      "scope": { "project_key": "ACME" },
      "provides": ["ticket.view", "ticket.comment", "ticket.change_status"],
      "handles": ["ticket.view", "ticket.comment"],
      "routing": { "ticket_id_patterns": ["^ACME-[1-9][0-9]*$"], "priority": 10 },
      "workflow": { "skill": "acme-ticket-workflow", "policy": { "ticket.view": "allow", "ticket.comment": "confirm" } }
    },
    "agency_redmine": {
      "kind": "ticketing",
      "platform": "redmine",
      "url": "https://redmine.agency.example",
      "scope": { "project_identifier": "acme-build" },
      "auth": { "mode": "env", "api_key_env": "REDMINE_AGENCY_API_KEY" },
      "provides": ["ticket.view", "ticket.log_time"],
      "handles": ["ticket.log_time"],
      "routing": { "ticket_id_patterns": ["^#[1-9][0-9]*$"], "priority": 20 },
      "workflow": { "policy": { "ticket.log_time": "confirm" } }
    },
    "agency_gitlab": {
      "kind": "forge",
      "platform": "gitlab",
      "url": "https://gitlab.agency.example",
      "auth": { "mode": "env", "token_env": "GITLAB_AGENCY_TOKEN" },
      "provides": ["pull_merge_request.view", "pull_merge_request.create", "pull_merge_request.edit", "pull_merge_request.comment", "pull_merge_request.request_review", "pipeline.view", "pipeline.job.view_log"],
      "handles": ["pull_merge_request.view", "pull_merge_request.create", "pull_merge_request.edit", "pull_merge_request.comment", "pull_merge_request.request_review", "pipeline.view", "pipeline.job.view_log"],
      "workflow": { "skill": "acme-code-workflow", "policy": { "pull_merge_request.view": "allow", "pull_merge_request.create": "confirm", "pull_merge_request.edit": "confirm", "pull_merge_request.comment": "confirm", "pull_merge_request.request_review": "confirm", "pipeline.view": "allow", "pipeline.job.view_log": "allow" } }
    }
  },
  "repos": {
    "root": { "path": ".", "role": "orchestrator", "labels": ["platform"], "integrations": { "agency_gitlab": "acme/shop-galaxy" } },
    "api": { "path": "www/api", "labels": ["backend", "critical"], "depends_on": ["root"], "integrations": { "agency_gitlab": "acme/api" } }
  },
  "environments": { "local": { "label": "Local", "repo": "api" } },
  "capsules": { "test": { "label": "API tests", "type": "test", "program": "make", "args": ["test"], "repo": "api", "environment": "local" } },
  "docs": { "architecture": { "path": "doc/architecture.md", "repo": "root", "label": "Architecture" } }
}
